#include <Arduino.h>
#include <micro_ros_platformio.h>

#include <rcl/rcl.h>
#include <rcl/error_handling.h>
#include <rclc/rclc.h>
#include <rclc/executor.h>

#include <geometry_msgs/msg/twist.h>
#include <nav_msgs/msg/odometry.h>
#include <std_msgs/msg/float32.h>

#include "config.h"
#include "MotorDriver.hpp"
#include "Odometry.hpp"
#include "RcReceiver.hpp"
#include "VoltageSensor.hpp"
#include "SafetyEstop.hpp"

// ============================================================
// グローバルオブジェクト
// ============================================================
MotorDriver motor_l(MOTOR_L_PWM_PIN, MOTOR_L_DIR_PIN);
MotorDriver motor_r(MOTOR_R_PWM_PIN, MOTOR_R_DIR_PIN);
Odometry odom;
RcReceiver rc;
VoltageSensor voltage_sensor;

enum ControlMode { MODE_MANUAL, MODE_ROS2 };
volatile ControlMode g_control_mode = MODE_MANUAL;  // 起動時は安全のため手動モード
volatile float g_cmd_linear = 0.0f;
volatile float g_cmd_angular = 0.0f;

// ============================================================
// micro-ROS関連
// ============================================================
rcl_allocator_t allocator;
rclc_support_t support;
rcl_node_t node;
rclc_executor_t executor;

rcl_publisher_t odom_publisher;
rcl_publisher_t voltage_publisher;
rcl_subscription_t cmd_vel_subscriber;

nav_msgs__msg__Odometry odom_msg;
std_msgs__msg__Float32 voltage_msg;
geometry_msgs__msg__Twist cmd_vel_msg;

enum AgentState { WAITING_AGENT, AGENT_AVAILABLE, AGENT_CONNECTED, AGENT_DISCONNECTED };
AgentState agent_state = WAITING_AGENT;

#define RCCHECK(fn) { rcl_ret_t rc = fn; if (rc != RCL_RET_OK) { /* エラー時は再接続シーケンスに委ねる */ } }
#define EXECUTE_EVERY_N_MS(MS, X) do { \
    static volatile int64_t init = -1; \
    if (init == -1) { init = uxr_millis(); } \
    if (uxr_millis() - init > MS) { X; init = uxr_millis(); } \
} while (0)

// ============================================================
// cmd_vel コールバック (ROS2からの指令受信)
// ============================================================
void cmdVelCallback(const void *msgin) {
    const geometry_msgs__msg__Twist *msg = (const geometry_msgs__msg__Twist *)msgin;
    g_cmd_linear = (float)msg->linear.x;
    g_cmd_angular = (float)msg->angular.z;
}

bool createEntities() {
    allocator = rcl_get_default_allocator();

    RCCHECK(rclc_support_init(&support, 0, NULL, &allocator));
    RCCHECK(rclc_node_init_default(&node, "cugo_esp32_node", "", &support));

    RCCHECK(rclc_publisher_init_default(
        &odom_publisher, &node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(nav_msgs, msg, Odometry),
        "odom"));

    RCCHECK(rclc_publisher_init_default(
        &voltage_publisher, &node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs, msg, Float32),
        "battery_voltage"));

    RCCHECK(rclc_subscription_init_default(
        &cmd_vel_subscriber, &node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(geometry_msgs, msg, Twist),
        "cmd_vel"));

    RCCHECK(rclc_executor_init(&executor, &support.context, 1, &allocator));
    RCCHECK(rclc_executor_add_subscription(
        &executor, &cmd_vel_subscriber, &cmd_vel_msg, &cmdVelCallback, ON_NEW_DATA));

    // frame_idは静的文字列を割り当てるだけなので毎回のmalloc回避
    odom_msg.header.frame_id.data = (char *)"odom";
    odom_msg.header.frame_id.size = strlen("odom");
    odom_msg.header.frame_id.capacity = odom_msg.header.frame_id.size + 1;
    odom_msg.child_frame_id.data = (char *)"base_link";
    odom_msg.child_frame_id.size = strlen("base_link");
    odom_msg.child_frame_id.capacity = odom_msg.child_frame_id.size + 1;

    return true;
}

void destroyEntities() {
    rmw_context_t *rmw_context = rcl_context_get_rmw_context(&support.context);
    (void)rmw_uros_set_context_entity_destroy_session_timeout(rmw_context, 0);

    rcl_publisher_fini(&odom_publisher, &node);
    rcl_publisher_fini(&voltage_publisher, &node);
    rcl_subscription_fini(&cmd_vel_subscriber, &node);
    rclc_executor_fini(&executor);
    rcl_node_fini(&node);
    rclc_support_fini(&support);
}

void publishOdometry() {
    odom_msg.pose.pose.position.x = odom.x;
    odom_msg.pose.pose.position.y = odom.y;
    odom_msg.pose.pose.position.z = 0.0;

    float half_theta = odom.theta * 0.5f;
    odom_msg.pose.pose.orientation.x = 0.0;
    odom_msg.pose.pose.orientation.y = 0.0;
    odom_msg.pose.pose.orientation.z = sinf(half_theta);
    odom_msg.pose.pose.orientation.w = cosf(half_theta);

    odom_msg.twist.twist.linear.x = odom.v_linear;
    odom_msg.twist.twist.angular.z = odom.v_angular;

    rcl_publish(&odom_publisher, &odom_msg, NULL);
}

void publishVoltage(float v) {
    voltage_msg.data = v;
    rcl_publish(&voltage_publisher, &voltage_msg, NULL);
}

// ============================================================
// cmd_vel(linear, angular) -> 左右ホイール速度[m/s]
// ============================================================
void cmdVelToWheelSpeed(float linear, float angular, float &out_left, float &out_right) {
    using namespace CugoParams;
    out_left  = linear - (angular * TREAD / 2.0f);
    out_right = linear + (angular * TREAD / 2.0f);
}

// ============================================================
// Core 0: 制御ループ (エンコーダ/オドメトリ/モタドラ/estop/RC/電圧監視)
// micro-ROSのexecutor spinとは独立させ、通信の遅延に影響されないようにする
// ============================================================
void controlLoopTask(void *arg) {
    odom.begin(ENC_L_A_PIN, ENC_L_B_PIN, ENC_R_A_PIN, ENC_R_B_PIN);
    motor_l.begin();
    motor_r.begin();

    const uint8_t rc_pins[RC_NUM_CHANNELS] = { RC_THROTTLE_PIN, RC_STEER_PIN, RC_MODE_SW_PIN };
    rc.begin(rc_pins, RC_NUM_CHANNELS);

    voltage_sensor.begin(VOLTAGE_SENSE_PIN, VOLTAGE_DIVIDER_RATIO);

    const TickType_t period = pdMS_TO_TICKS(1000 / CONTROL_LOOP_HZ);
    TickType_t last_wake = xTaskGetTickCount();
    const float dt = 1.0f / CONTROL_LOOP_HZ;

    while (true) {
        odom.update(dt);

        // --- 電圧監視 ---
        float voltage = voltage_sensor.readVoltage();
        if (voltage < VOLTAGE_CUTOFF_THRESHOLD) {
            SafetyEstop::trigger();
        }

        // --- RC受信ロスト判定 (フェイルセーフ) ---
        bool rc_ok = rc.isSignalValid(CH_MODE_SW, RC_SIGNAL_TIMEOUT_MS);
        if (!rc_ok) {
            SafetyEstop::trigger();
        }

        // --- モード切り替え (RCのモードスイッチCH) ---
        if (rc_ok) {
            uint16_t sw_pulse = rc.getPulseWidth(CH_MODE_SW);
            g_control_mode = (sw_pulse > RC_PULSE_MID) ? MODE_ROS2 : MODE_MANUAL;
        }

        // --- 目標ホイール速度の決定 ---
        float target_l = 0.0f, target_r = 0.0f;

        if (!g_estop_active) {
            if (g_control_mode == MODE_ROS2) {
                cmdVelToWheelSpeed(g_cmd_linear, g_cmd_angular, target_l, target_r);
            } else if (rc_ok) {
                float throttle = RcReceiver::pulseToNormalized(rc.getPulseWidth(CH_THROTTLE));
                float steer    = RcReceiver::pulseToNormalized(rc.getPulseWidth(CH_STEER));
                float linear  = throttle * MAX_LINEAR_SPEED;
                float angular = steer * MAX_ANGULAR_SPEED;
                cmdVelToWheelSpeed(linear, angular, target_l, target_r);
            }
        }

        // --- モータ出力 (MotorDriver::setSpeed内部でもestopを再チェックする) ---
        motor_l.setSpeed(target_l / MAX_LINEAR_SPEED);
        motor_r.setSpeed(target_r / MAX_LINEAR_SPEED);

        vTaskDelayUntil(&last_wake, period);
    }
}

// ============================================================
// Core 1: micro-ROS通信タスク (Agent接続待ち・再接続に対応)
// ============================================================
void microRosTask(void *arg) {
    Serial.begin(115200);
    set_microros_serial_transports(Serial);

    while (true) {
        switch (agent_state) {
            case WAITING_AGENT:
                agent_state = (RMW_RET_OK == rmw_uros_ping_agent(200, 3))
                    ? AGENT_AVAILABLE : WAITING_AGENT;
                break;

            case AGENT_AVAILABLE:
                agent_state = createEntities() ? AGENT_CONNECTED : WAITING_AGENT;
                if (agent_state == WAITING_AGENT) {
                    destroyEntities();
                }
                break;

            case AGENT_CONNECTED:
                EXECUTE_EVERY_N_MS(200, {
                    agent_state = (RMW_RET_OK == rmw_uros_ping_agent(100, 1))
                        ? AGENT_CONNECTED : AGENT_DISCONNECTED;
                });
                if (agent_state == AGENT_CONNECTED) {
                    rclc_executor_spin_some(&executor, RCL_MS_TO_NS(20));
                    publishOdometry();
                    publishVoltage(voltage_sensor.readVoltage());
                }
                break;

            case AGENT_DISCONNECTED:
                destroyEntities();
                agent_state = WAITING_AGENT;
                break;
        }

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// ============================================================
// setup / loop
// ============================================================
void setup() {
    SafetyEstop::begin(ESTOP_PIN);

    xTaskCreatePinnedToCore(
        controlLoopTask, "control_loop", 4096, NULL, 2, NULL, 0);

    xTaskCreatePinnedToCore(
        microRosTask, "micro_ros", 8192, NULL, 1, NULL, 1);
    ros_setup();
    encoder_open();
    vel_ctrl_set();

    delay(500);
}

void loop() {
    rclc_executor_spin_some(&executor, RCL_MS_TO_NS(100))
    // 全ての処理はFreeRTOSタスク側で行うため、Arduinoのloop()は使用しない
    vTaskDelete(NULL);
}
